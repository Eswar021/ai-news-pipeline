# ── News APIs ─────────────────────────────────────────────────────────────────
# https://newsdata.io/
NEWSDATA_API=your_newsdata_api_key

# https://mediastack.com/
MEDIASTACK_API=your_mediastack_api_key

# https://newsapi.org/
NewsAPI=your_newsapi_key

# ── YouTube Data API v3 ───────────────────────────────────────────────────────
# https://console.cloud.google.com/ → YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_api_key

# ── LLM: Google Gemini ────────────────────────────────────────────────────────
# https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash-lite

# ── LLM: OpenAI ───────────────────────────────────────────────────────────────
# https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o

# ── LLM: Local (LM Studio) ────────────────────────────────────────────────────
# Download LM Studio from https://lmstudio.ai/ and start the local server
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=your_local_model_name
LMSTUDIO_API_KEY=lm-studio
